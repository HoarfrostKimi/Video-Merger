#!/bin/sh
# ============================================================
# Git Pre-Commit 钩子（方案B：检查标记文件）
# 功能：在每次 git commit 前检查测试和质量标记文件是否存在
# 通过 → 允许提交
# 失败 → 拒绝提交
# 跳过方式：git commit --no-verify
# ============================================================

echo ""
echo "=========================================="
echo "  视频合并app - 提交前质量守卫"
echo "=========================================="
echo ""

# 获取项目根目录
PROJECT_ROOT=$(git rev-parse --show-toplevel)
QUALITY_DIR="$PROJECT_ROOT/.quality"

# ============ 第一步：扩展构建产物一致性（仅在提交涉及扩展时） ============
# 目的：dist/content.js 是入库的构建产物，最容易出现「改了 src 忘了 build」
# 或「build 了但只 add 了 src」。此时运行的就是旧代码，排查半天找不到原因。
staged_ext=$(git diff --cached --name-only | grep '^bilibili-extension/' || true)
if [ -n "$staged_ext" ]; then
    echo "[1/3] 检查扩展构建产物..."
    echo ""
    ext_dir="$PROJECT_ROOT/bilibili-extension"
    if [ ! -d "$ext_dir/node_modules" ]; then
        echo "⚠️  未安装依赖（bilibili-extension/node_modules 缺失），跳过构建检查"
    elif ! ( cd "$ext_dir" && node esbuild.config.mjs >/dev/null 2>&1 ); then
        echo "❌ 扩展构建失败（src/content 里有语法错误？）"
        echo ""
        echo "修复：cd bilibili-extension && npm run build"
        echo ""
        exit 1
    elif git diff --quiet -- bilibili-extension/dist/content.js; then
        echo "✅ dist/content.js 与 src 一致"
    else
        echo "❌ dist/content.js 与 src 不一致"
        echo ""
        echo "  说明：暂存的 dist 不是当前 src 构建出来的结果，运行时会用旧代码。"
        echo ""
        echo "修复："
        echo "  cd bilibili-extension && npm run build"
        echo "  git add bilibili-extension/dist/content.js"
        echo ""
        exit 1
    fi
    echo ""
fi

# ============ 第二步：检查测试标记 ============
echo "[2/3] 检查单元测试标记..."
echo ""

if [ -f "$QUALITY_DIR/test-passed.marker" ]; then
    echo "✅ 单元测试标记存在，测试已通过"
else
    echo "❌ 未找到测试通过标记文件"
    echo ""
    echo "=========================================="
    echo "  请先运行 test-specialist agent 生成测试标记！"
    echo "=========================================="
    echo ""
    echo "操作建议："
    echo "  1. 对我说 \"跑测试\" 或 \"帮我提交代码\""
    echo ""
    exit 1
fi

echo ""

# ============ 第三步：检查质量标记 ============
echo "[3/3] 检查质量检查标记..."
echo ""

if [ -f "$QUALITY_DIR/quality-passed.marker" ]; then
    echo "✅ 质量检查标记存在，质量检查已通过"
else
    echo "❌ 未找到质量检查通过标记文件"
    echo ""
    echo "=========================================="
    echo "  请先运行 quality-engineer agent 生成质量标记！"
    echo "=========================================="
    echo ""
    echo "操作建议："
    echo "  1. 对我说 \"质量检查\" 或 \"帮我提交代码\""
    echo ""
    exit 1
fi

echo ""
echo "=========================================="
echo "  所有检查通过，允许提交！"
echo "=========================================="
echo ""

# ============ 第四步：清理标记文件（防止用旧通行证）============
echo "[4/4] 清理旧的标记文件..."
rm -f "$QUALITY_DIR"/*.marker
echo "✅ 已清理标记文件，下次提交需重新检查"
echo ""

exit 0
